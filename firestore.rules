rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'admin-23it227-midterm';
    }

    function validProduct(product) {
      let fields = ['name', 'price', 'soluong', 'image'];
      return product.keys().hasAll(fields) && product.keys().hasOnly(fields)
        && product.name is string && product.name.size() > 0 && product.name.size() <= 100
        && (product.price is int || product.price is float)
        && product.price >= 0 && product.price <= 999999999999
        && product.soluong is int && product.soluong >= 0 && product.soluong <= 2147483647
        && product.image is string && product.image.size() > 0 && product.image.size() <= 349528;
    }

    match /products/{productId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
    }
  }
}
